# ══════════════════════════════════════════════════
#  Grail Bot — переменные окружения
#  Скопируйте этот файл в .env и заполните значения
#  cp .env.example .env
# ══════════════════════════════════════════════════

# ── ОБЯЗАТЕЛЬНО ────────────────────────────────────

# Ключ шифрования приватных ключей (AES-256-GCM)
# Генерация: openssl rand -hex 32
MASTER_KEY=замените_на_64_символа_hex

# Privy.io JWT токен для авторизации в API Grail.xyz
# Как получить:
#   1. Открой grail.xyz в Chrome → F12 (DevTools) → Network → XHR
#   2. Купи пак вручную
#   3. Найди запрос /api/packs/redeem/prepare
#   4. Headers → Authorization → скопируй токен (без "Bearer ")
# ВНИМАНИЕ: токен живёт 1 час! Обновлять перед каждым запуском.
GRAIL_PRIVY_TOKEN=

# Базовый URL Grail API (менять не нужно)
GRAIL_API_URL=https://grail.xyz

# ID пака — строка из API (например GRAILGENESISPACKS6)
# Найти: в поле pack_id ответа /api/packs/redeem/prepare
GRAIL_PACK_ID=GRAILGENESISPACKS6

# Нужна ли подпись от бэкенда (всегда true для Grail)
GRAIL_BACKEND_SIG=true

# ── TELEGRAM-УВЕДОМЛЕНИЯ ───────────────────────────

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# ID чата или канала для уведомлений
# Для личных сообщений: узнать через @userinfobot
# Для канала: -100XXXXXXXXXX (с минусом)
TELEGRAM_CHAT_ID=

# ── КОНТРАКТЫ (обычно менять не нужно) ─────────────

# Адрес контракта продажи паков
GRAIL_PACK_SALE=0x4491ac59d1e6a5d2e15a8048c2de34199e8de8da

# Адрес NFT-контракта паков
GRAIL_PACK_NFT=0xc7bd7aa20841e43838648131768735f32d15aafa

# Цена пака в raw USDC (15 USDC = 15000000, 6 decimals)
GRAIL_PACK_PRICE_RAW=15000000

# Тип NFT: false = ERC721, true = ERC1155
GRAIL_NFT_ERC1155=false

# ── ОПЦИОНАЛЬНЫЕ ───────────────────────────────────

# Количество паков покупаемых за один кошелёк (по умолчанию 1)
PACKS_PER_WALLET=1

# Название функции покупки в контракте (попробовать: buy, mint, purchasePacks)
GRAIL_BUY_FUNCTION=buy

# ID коллекции для API-запросов (если нужен)
GRAIL_COLLECTION_ID=

# Уровень логирования: trace | debug | info | warn | error
LOG_LEVEL=info
